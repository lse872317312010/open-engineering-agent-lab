{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oeal.local/schemas/ir-0.2.json",
  "$defs": {
    "ModelSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ModelSpec"
        },
        "version": {
          "const": "0.2"
        },
        "profile": {
          "enum": [
            "native_foc_v1",
            "native_joint_v1",
            "motulator_pmsm_v1",
            "baldor_map_v1",
            "ur5e_joint_v1"
          ]
        },
        "parameters": {
          "type": "object",
          "properties": {
            "stator_resistance_ohm": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "ohm"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "d_inductance_h": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "H"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "q_inductance_h": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "H"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "flux_linkage_wb": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "Wb"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "pole_pairs": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit": {
                  "const": "1"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "inertia_kg_m2": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "kg*m^2"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "viscous_friction_nms": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "N*m*s/rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "version",
        "profile",
        "parameters"
      ],
      "additionalProperties": false
    },
    "ExperimentSpec": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ExperimentSpec"
        },
        "version": {
          "const": "0.2"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "model": {
          "$ref": "#/$defs/ModelSpec"
        },
        "backend": {
          "enum": [
            "native",
            "motulator",
            "mujoco_motulator"
          ]
        },
        "settings": {
          "type": "object",
          "properties": {
            "duration_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "control_period_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "integration_step_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "step_time_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "id_reference_a": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "const": "A"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "iq_reference_a": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "const": "A"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "vdc_v": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "V"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "current_limit_a": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "A"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "bandwidth_per_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "1/s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "tracking_rate_per_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "1/s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "delay_samples": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "unit": {
                  "const": "1"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "load_nm": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "const": "N*m"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "shaft_stiffness_nm_per_rad": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "N*m/rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "ambient_c": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": -273.15
                },
                "unit": {
                  "const": "degC"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "deadtime_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "device_drop_v": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "V"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "ripple_fraction": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "1"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "core_conductance_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "S"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "macro_step_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "backlash_rad": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "outer_kp_nm_per_rad": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "N*m/rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "outer_kd_nms_per_rad": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "N*m*s/rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "gravity_feedforward_gain": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "1"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "position_step_rad": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "const": "rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "position_start_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "position_ramp_s": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "s"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "payload_kg": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "const": "kg"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "pwm": {
              "type": "boolean"
            },
            "sensors": {
              "type": "boolean"
            },
            "thermal_feedback": {
              "type": "boolean"
            },
            "fixture": {
              "type": "boolean"
            },
            "dc_bus": {
              "enum": [
                "constant",
                "capacitor",
                "diode"
              ]
            },
            "energy_consistent": {
              "type": "boolean"
            },
            "coupling_method": {
              "enum": [
                "jacobi",
                "midpoint_predictor"
              ]
            },
            "robot_integrator": {
              "enum": [
                "implicitfast",
                "rk4"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "budget": {
          "type": "object",
          "properties": {
            "control_ticks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50000
            },
            "solver_evaluations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000000
            }
          },
          "required": [
            "control_ticks",
            "solver_evaluations"
          ],
          "additionalProperties": false
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "current_tail_error_a": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "A"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "position_tail_error_rad": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "rad"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "current_peak_a": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "A"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "shaft_torque_peak_nm": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "N*m"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            },
            "energy_balance_abs_j": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "J"
                }
              },
              "required": [
                "value",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "version",
        "id",
        "model",
        "backend",
        "settings",
        "seed",
        "budget",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "Stream": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "sample_semantics": {
          "enum": [
            "control_ticks_and_endpoint",
            "macro_ticks_and_endpoint",
            "switching_events",
            "solver_samples"
          ]
        }
      },
      "required": [
        "columns",
        "units",
        "samples",
        "sample_semantics"
      ],
      "additionalProperties": false
    },
    "SimulationResult": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "SimulationResult"
        },
        "version": {
          "const": "0.2"
        },
        "experiment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_level": {
          "const": "model_simulated"
        },
        "backend": {
          "enum": [
            "native",
            "motulator",
            "mujoco_motulator"
          ]
        },
        "profile": {
          "enum": [
            "native_foc_v1",
            "native_joint_v1",
            "motulator_pmsm_v1",
            "baldor_map_v1",
            "ur5e_joint_v1"
          ]
        },
        "primary_stream": {
          "enum": [
            "control",
            "joint"
          ]
        },
        "streams": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "control",
              "joint",
              "waveforms",
              "gates",
              "energy",
              "co_sim_energy",
              "coupling"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/Stream"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "numeric_passed": {
          "type": "boolean"
        },
        "goal_passed": {
          "type": "boolean"
        },
        "context": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "version",
        "experiment_sha256",
        "raw_sha256",
        "evidence_level",
        "backend",
        "profile",
        "primary_stream",
        "streams",
        "metrics",
        "numeric_passed",
        "goal_passed",
        "context"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ModelSpec"
    },
    {
      "$ref": "#/$defs/ExperimentSpec"
    },
    {
      "$ref": "#/$defs/SimulationResult"
    }
  ]
}
